# 可通过 --env-file .env 显式加载，或使用 PowerShell $env:NAME="value"。
# 离线 Mock 模式无需任何变量。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=replace-only-in-local-environment
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
LLM_JSON_MODE=1
LLM_THINKING=disabled
MAX_AGENT_STEPS=12
MAX_MODEL_CALLS=12
